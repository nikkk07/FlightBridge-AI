# Copy to .env (git-ignored). Never commit real values.
FLIGHTBRIDGE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
# Safety flags: keep these until explicit activation is approved.
DRY_RUN=true
OUTBOUND_ENABLED=false
# Hostinger Mail API (hPanel > Agentic Mail > API access). Leave empty until approved.
HOSTINGER_MAIL_API_TOKEN=
HOSTINGER_MAILBOX_RESOURCE_ID=
# Optional; default resolves the folder flagged \Sent (observed path: INBOX.Sent)
HOSTINGER_SENT_FOLDER=
# Inbox polling: hostinger (uses the token above) | imap | empty (off)
INBOUND_SOURCE=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# Optional LLM second opinion (can only RAISE risk). Off unless set.
# Free LLM (optional): groq or gemini. Used for website summaries and a second opinion on replies (can only raise risk).
FB_LLM_PROVIDER=
GROQ_API_KEY=
GEMINI_API_KEY=
# Leave empty for the provider default (groq: llama-3.1-8b-instant, gemini: gemini-2.5-flash)
FB_LLM_MODEL=
# Website discovery (Places API (New) must be enabled in the Google Cloud project)
GOOGLE_PLACES_API_KEY=
# The CRM backend (Render) needs FB_HOSTINGER_WEBHOOK_SECRET set to the webhook's secret to accept deliveries.
